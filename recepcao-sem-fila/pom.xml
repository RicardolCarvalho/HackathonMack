<?xml version="1.0" encoding="UTF-8"?>
<!-- Opcional: serve para abrir o projeto no IntelliJ/Eclipse/VS Code e gerar o jar com "mvn package".
     A aplicação não tem dependências externas; os scripts executar/testar funcionam sem Maven. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>br.com.recepcaosemfila</groupId>
  <artifactId>recepcao-sem-fila</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>
  <name>Recepção Sem Fila</name>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <build>
    <finalName>recepcao-sem-fila</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>br.com.recepcaosemfila.App</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
